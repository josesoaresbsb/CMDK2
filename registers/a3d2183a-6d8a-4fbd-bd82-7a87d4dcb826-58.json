    }, {
      "column_name" : "DS_SCRIPT_CRIACAO",
      "data_type" : "LONG",
      "new_value" : "CREATE OR REPLACE TRIGGER VVRE_TRG_PROJ_ELEMENT_BF_INSERT\nBEFORE INSERT ON VVRE_PROJ_ELEMENT\nFOR EACH ROW\nDECLARE\n    v_total_elementos   NUMBER := 0;\n    v_limite_projeto    NUMBER := 0;\nBEGIN\n    -- Soma dos elementos j\u00e1 existentes para o projeto\n    SELECT NVL(SUM(VL_ELEMENTO), 0)\n    INTO v_total_elementos\n    FROM VVRE_PROJ_ELEMENT\n    WHERE NR_SEQ_PROJETO = :NEW.NR_SEQ_PROJETO;\n\n    -- Buscar limite permitido do projeto\n    SELECT (VL_PROJETO - VL_SALDO)\n    INTO v_limite_projeto\n    FROM VVRE_PROJ_COMPRAS\n    WHERE NR_SEQUENCIA = :NEW.NR_SEQ_PROJETO;\n\n    -- Valida\u00e7\u00e3o\n    IF (v_total_elementos + :NEW.VL_ELEMENTO) > v_limite_projeto THEN\n        RAISE_APPLICATION_ERROR(\n            -20001,\n            'Valor do elemento ultrapassa o limite dispon\u00edvel do projeto.'\n        );\n    END IF;\n\nEXCEPTION\n    WHEN NO_DATA_FOUND THEN\n        RAISE_APPLICATION_ERROR(\n            -20002,\n            'Projeto n\u00e3o encontrado na VVRE_PROJ_COMPRAS.'\n        );\nEND;\n/",
