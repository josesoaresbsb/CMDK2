      "old_value" : "CREATE OR REPLACE PROCEDURE VVRE_TROCA_STATUS_PROJ_COMP (\n    P_NR_SEQ_PROJETO IN VVRE_PROJ_COMPRAS.NR_SEQUENCIA%TYPE,\n    P_IE_STATUS IN VVRE_PROJ_COMPRAS.IE_STATUS %TYPE)\nIS\n    V_NR_SEQUENCIA VVRE_HIST_PROJ.NR_SEQUENCIA%TYPE;\nBEGIN\n\n    -- Insere o registro\n    UPDATE VVRE_PROJ_COMPRAS SET IE_STATUS = P_IE_STATUS, DT_ATUALIZACAO = sysdate,\n    NM_USUARIO = obter_usuario_ativo\n    where NR_SEQUENCIA = P_NR_SEQ_PROJETO;\n    \n    -- Gerar hist\u00f3ricos\n    VVRE_GERAR_HIST_PROJ_COMP(P_NR_SEQ_PROJETO,'Troca de status realizada. /n Status: '||P_IE_STATUS || ', Usuario: '|| obter_usuario_ativo);\n\n    COMMIT;\nEXCEPTION\n    WHEN OTHERS THEN\n        ROLLBACK;\n        RAISE;\nEND VVRE_TROCA_STATUS_PROJ_COMP;\n/"
